# Database
DATABASE_URL=postgresql+psycopg://inmonexo:inmonexo@localhost:5432/inmonexo

# Scraping
SCRAPE_RATE_LIMIT_SECONDS=1.0
SCRAPE_USER_AGENT=InmoNExoBot/0.1 (+https://localhost; research)

# API (puerto 8100 — evita colisión con otros servicios en :8000)
API_HOST=127.0.0.1
API_PORT=8100

# Web Next.js usa :3100; ver apps/web/.env.example

# Apify (live fetch — never commit real token)
APIFY_TOKEN=
APIFY_DEFAULT_ACTOR=apify/cheerio-scraper
