{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "INMONEXO_API_URL"
        }
      ]
    },
    "api": {
      "root": ".",
      "entrypoint": "backend/main:app"
    }
  },
  "rewrites": [
    {
      "source": "/svc/:path*",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
